# --- Backend ---
PORT=3107
# Interfaz donde escucha. Tailscale Funnel llega por 127.0.0.1; no hace falta exponerlo en la red.
HOST=127.0.0.1
# Nombre con que la skill se presenta por voz ("Mango listo. Puedes hablarme." / "Mango is ready.").
ASSISTANT_NAME=Mango
# Nombre de la skill en la app Alexa (lo sube `npm run skill -- endpoint`).
SKILL_NAME=Mango con Maracuyá
# Frase con la que vuelves a abrir la skill (la rutina de la app Alexa). Se usa en los mensajes hablados.
ALEXA_RETURN_PHRASE=Alexa, mango
# La misma frase cuando se le habla en inglés (requests en-US).
ALEXA_RETURN_PHRASE_EN=Alexa, open mango
# Sonido de la biblioteca de Alexa antes de leer una respuesta que esperó ("repite" o al volver a abrir). Vacío = sin sonido.
READY_SOUND=soundbank://soundlibrary/alarms/beeps_and_bloops/bell_02

# --- Agente (cualquier endpoint /v1/chat/completions compatible con OpenAI) ---
# Hermes Agent: platforms.api_server en ~/.hermes/config.yaml (host, port, key).
HERMES_GATEWAY_URL=http://127.0.0.1:8742/v1/chat/completions
HERMES_GATEWAY_TOKEN=change-me
HERMES_API_MODEL=hermes-agent
# Alexa corta a los ~8 s: pasado este plazo responde "me va a tomar un momento" y la consulta sigue en segundo plano.
VOICE_GATEWAY_TIMEOUT_MS=5000
# Máximo que se espera al agente antes de darse por vencido (las tareas con herramientas pueden tardar minutos).
HERMES_MAX_WAIT_MS=600000
# Tareas largas (voz y MCP): se guardan aquí y sobreviven reinicios. Vencen TASK_TTL_MS después de creadas (24 h).
TASKS_FILE=./data/tasks.json
TASK_TTL_MS=86400000

# --- Alexa ---
# Lo rellena `npm run skill -- create`.
ALEXA_SKILL_ID=
# Locale de tu Echo (app Alexa → Dispositivos → tu Echo → Idioma). es-US es el más probado.
ALEXA_LOCALE=es-US
# URL pública del backend (Tailscale Funnel u otro HTTPS con certificado válido, puerto 443).
ALEXA_ENDPOINT=https://tu-maquina.tu-tailnet.ts.net/alexa
# Verificación de firma de Amazon. Solo true para pruebas locales con requests sintéticas.
ALEXA_SKIP_VERIFICATION=false

# --- Acceso (opcional) ---
# userIds de Alexa permitidos, separados por coma. Vacío = cualquiera que pueda abrir la skill
# (en etapa development, solo los dispositivos de tu cuenta Amazon).
ALLOW_USER_IDS=
PIN_REQUIRED=false
ALEXA_LINK_PIN=
SESSION_FILE=./data/sessions.json
# Registro de cada request y evento de voz (el adapter de ask-sdk rechaza sin dejar log).
ALEXA_DEBUG_LOG=./data/alexa-debug.log

# --- Servidor MCP (/mcp, Streamable HTTP) ---
# Token que los clientes MCP mandan como "Authorization: Bearer <MCP_TOKEN>". Vacío = MCP apagado (503).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_TOKEN=
# Hostnames permitidos en el header Origin (los clientes que no son navegador no lo envían).
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]

# --- Identificación por voz (Voice ID) ---
# off: atiende a todos y solo registra si Alexa reconoció la voz. enroll: guarda al primer hablante reconocido
# como dueño (data/voice-owner.json). enforce: solo el dueño (o, sin dueño, cualquier voz reconocida) llega al agente.
# Requiere el permiso alexa::person_id:read (config/skill-manifest.json) y "Personalizar skills" en tu Voice ID.
VOICE_ID_MODE=off
# Modo para los requests en inglés (en-US). Vacío = el mismo de VOICE_ID_MODE.
# El Voice ID solo funciona bien en el idioma en que lo grabaste:
#   grabado en español → VOICE_ID_MODE=enforce, VOICE_ID_MODE_EN=off
#   grabado en inglés  → VOICE_ID_MODE=off,     VOICE_ID_MODE_EN=enforce
VOICE_ID_MODE_EN=
# Alternativa a enroll: el personId del dueño (aparece en el log solo como hash; tómalo de un request real).
VOICE_OWNER_PERSON_ID=
# Frases seguidas de otras voces tras las que se cierra la sesión, y si se ignoran sin hablar.
VOICE_ID_MAX_IGNORED=3
VOICE_ID_SILENT=false
