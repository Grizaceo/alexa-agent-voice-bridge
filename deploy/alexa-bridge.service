# Servicio de usuario systemd para el backend.
# Instalar:
#   cp deploy/alexa-bridge.service ~/.config/systemd/user/
#   (ajusta WorkingDirectory y la ruta de node: `which node`)
#   systemctl --user daemon-reload && systemctl --user enable --now alexa-bridge
#   loginctl enable-linger "$USER"   # para que arranque sin sesión abierta
[Unit]
Description=Alexa voice bridge (Echo -> agente propio)
After=network-online.target

[Service]
WorkingDirectory=%h/alexa-agent-voice-bridge
ExecStart=/usr/bin/env node src/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
